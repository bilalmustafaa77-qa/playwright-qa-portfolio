{
  "name": "playwright-qa-portfolio",
  "version": "1.0.0",
  "description": "QA automation portfolio: Playwright (TypeScript) UI and API tests with CI on GitHub Actions",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "author": "Bilal Mustafa",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
